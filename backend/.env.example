PROJECT_NAME="AarogyaFlow"
ENV="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/aarogyaflow_db"

# Security
SECRET_KEY="your-super-secret-key-32bytes-minimum"
ENCRYPTION_KEY="your-fernet-encryption-key"
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM="HS256"

# ABDM / ABHA Integration Settings
ABDM_CLIENT_ID="your_abdm_client_id"
ABDM_CLIENT_SECRET="your_abdm_client_secret"
ABDM_BASE_URL="https://dev.abdm.gov.in/gateway"

# AI / Speech / OCR Service Keys
OPENAI_API_KEY="your_openai_api_key"
OCR_API_KEY="your_ocr_api_key"
ASR_SERVICE_URL="http://localhost:8001/asr"
TTS_SERVICE_URL="http://localhost:8001/tts"
