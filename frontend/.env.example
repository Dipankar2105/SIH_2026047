# AarogyaFlow Frontend Environment Configuration

# Backend API URL (FastAPI backend)
# For web/browser: http://localhost:8000/api/v1
# For Android Emulator: http://10.0.2.2:8000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Real-time WebSocket OPD Queue URL
# For web/browser: ws://localhost:8000/hospital/mock-hospital/queue/ws
# For Android Emulator: ws://10.0.2.2:8000/hospital/mock-hospital/queue/ws
NEXT_PUBLIC_WS_URL=ws://localhost:8000/hospital/mock-hospital/queue/ws

# ABDM Sandbox Gateway Configuration
NEXT_PUBLIC_ABDM_BASE_URL=https://dev.abdm.gov.in/gateway
NEXT_PUBLIC_ABDM_CLIENT_ID=sbx-aarogyaflow-patient-app
